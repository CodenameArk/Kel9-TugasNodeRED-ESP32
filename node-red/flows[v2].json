    {
        "id": "a1b2c3d4e5f60502",
        "type": "function",
        "z": "a1b2c3d4e5f60001",
        "name": "simpan ke DB",
        "func": "// msg.topic: pens/klp9/ruangN/(temperature|humidity)\nconst p = msg.topic.split(\"/\");\nconst ruang = p[2], jenis = p[3];\nconst nilai = parseFloat(msg.payload);\nif (!/^ruang[1-4]$/.test(ruang)) return null;\nif (jenis !== \"temperature\" && jenis !== \"humidity\") return null;\nif (isNaN(nilai)) return null;\nreturn { topic: `INSERT INTO data_sensor (waktu,ruang,jenis,nilai) VALUES (${Date.now()},'${ruang}','${jenis}',${nilai})` };",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 120,
        "wires": [
            [
                "a1b2c3d4e5f60503"
            ]
        ]
