    {
        "id": "a1b2c3d4e5f60515",
        "type": "function",
        "z": "a1b2c3d4e5f60001",
        "name": "bentuk query",
        "func": "// Dropdown kirim \"jenis:menit\", tombol Refresh kirim \"refresh\" (pakai pilihan terakhir)\nlet pilih;\nif (typeof msg.payload === \"string\" && msg.payload.includes(\":\")) {\n    pilih = msg.payload;\n    flow.set(\"pilihRiwayat\", pilih);\n} else {\n    pilih = flow.get(\"pilihRiwayat\") || \"temperature:60\";\n}\nconst [jenis, menitStr] = pilih.split(\":\");\nconst menit = parseInt(menitStr);\nif ((jenis !== \"temperature\" && jenis !== \"humidity\") || isNaN(menit)) return null;\nconst sejak = Date.now() - menit * 60000;\nconst bucket = Math.max(5000, Math.round(menit * 60000 / 150)); // rata-rata per bucket (~150 titik)\nmsg.topic = `SELECT ruang, (waktu/${bucket})*${bucket} AS t, ROUND(AVG(nilai),1) AS v FROM data_sensor WHERE jenis='${jenis}' AND waktu>=${sejak} GROUP BY ruang, t ORDER BY t ASC`;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 990,
        "y": 290,
        "wires": [
            [
                "a1b2c3d4e5f60516"
            ]
        ]
    },
