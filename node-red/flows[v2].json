        "type": "function",
        "z": "a1b2c3d4e5f60001",
        "name": "format chart v2",
        "func": "// Di Dashboard 2.0 (ui-chart), data array objek [{ruang, t, v}] langsung di-plot\n// menggunakan category=\"ruang\", x=\"t\", y=\"v\", dan action=\"replace\"\nconst rows = Array.isArray(msg.payload) ? msg.payload : [];\nmsg.payload = rows.map(r => ({\n    ruang: String(r.ruang),\n    t: Number(r.t),\n    v: Number(r.v)\n}));\nreturn msg;",
